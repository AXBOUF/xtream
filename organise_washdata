#!/usr/bin/env bash

BASE_DIR="/workspaces/xtream/project0/dataschema"

# Create month folders
months=(January February March April May June July August September October November December)

for month in "${months[@]}"; do
    mkdir -p "$BASE_DIR/$month"
done

# Move files into respective month folders
for file in "$BASE_DIR"/washdata_*.xlsx; do
    filename=$(basename "$file")

    # Extract MM from washdata_DDMMYYYY.xlsx
    month_num=${filename:11:2}

    case $month_num in
        01) target="January" ;;
        02) target="February" ;;
        03) target="March" ;;
        04) target="April" ;;
        05) target="May" ;;
        06) target="June" ;;
        07) target="July" ;;
        08) target="August" ;;
        09) target="September" ;;
        10) target="October" ;;
        11) target="November" ;;
        12) target="December" ;;
        *) echo "Skipping unknown file: $filename"; continue ;;
    esac

    mv "$file" "$BASE_DIR/$target/"
    echo "Moved $filename → $target/"
done

echo "✅ All files organised by month"
